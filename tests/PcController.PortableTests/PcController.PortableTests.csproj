<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PcController.Host/PcController.Host.csproj" />
    <!-- Pure Windows mapping table regression data; no native/WPF assembly reference. -->
    <Compile Include="../../src/PcController.Windows/WindowsMediaMappings.cs" Link="WindowsMediaMappings.cs" />
    <!-- Pure "Restart to update" rules (installed-copy detection, installer arguments); no registry or process use. -->
    <Compile Include="../../src/PcController.Windows/WindowsUpdateRules.cs" Link="WindowsUpdateRules.cs" />
    <Content Include="../../src/remote/dist/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
