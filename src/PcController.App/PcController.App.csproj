<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.3.0</Version>
    <Product>PC Remote</Product>
    <ApplicationIcon>../remote/public/pc-remote-v2.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../remote/public/pc-remote-v2-128.png" Link="Assets/pc-remote-logo.png" />
    <Resource Include="../remote/public/pc-remote-v2.ico" Link="Assets/pc-remote.ico" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <ProjectReference Include="../PcController.Core/PcController.Core.csproj" />
    <ProjectReference Include="../PcController.Host/PcController.Host.csproj" />
    <ProjectReference Include="../PcController.Windows/PcController.Windows.csproj" />
    <Content Include="../remote/dist/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireMobileAssets" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../remote/dist/index.html')" Text="Build mobile assets first: run scripts/build.ps1." />
  </Target>
</Project>
