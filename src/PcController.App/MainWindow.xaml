<Window x:Class="PcController.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PC Remote — connection setup" Width="1020" Height="850" MinWidth="820" MinHeight="600" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Icon="Assets/pc-remote.ico">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Image Source="Assets/pc-remote-logo.png" Width="44" Height="44" Margin="0,0,16,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="PC Remote" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" /><Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#8A95A5" Margin="24,0,8,0" /><TextBlock x:Name="Status" Text="Starting HTTPS…" Style="{StaticResource MutedText}" VerticalAlignment="Center" /></StackPanel>
      <Button Grid.Column="2" Click="OpenSettings" Padding="20,10" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><Path Data="M9,3 L8.5,5 L6.5,6 L4.5,5.5 L2.5,8.5 L4,10 L4,13 L2.5,14.5 L4.5,17.5 L6.5,17 L8.5,18 L9,20 L13,20 L13.5,18 L15.5,17 L17.5,17.5 L19.5,14.5 L18,13 L18,10 L19.5,8.5 L17.5,5.5 L15.5,6 L13.5,5 L13,3 Z M14,11.5 A3,3 0 1 1 8,11.5 A3,3 0 1 1 14,11.5" Stroke="#A1ADBD" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" /><TextBlock Text="Settings" FontSize="15" VerticalAlignment="Center" /></StackPanel></Button>
    </Grid>
    <!-- Update banner: the one-time automatic-check question, then signed release notices. -->
    <Border Grid.Row="1" x:Name="UpdateBanner" Visibility="Collapsed" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" AutomationProperties.AutomationId="update-banner"><StackPanel>
      <TextBlock x:Name="UpdateTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="update-title" />
      <TextBlock x:Name="UpdateText" Style="{StaticResource MutedText}" Margin="0,4,0,0" AutomationProperties.AutomationId="update-text" />
      <StackPanel x:Name="UpdateConsentButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Don't check" Click="DeclineUpdateChecks" Margin="0,0,10,0" AutomationProperties.AutomationId="update-consent-off" /><Button Content="Check automatically" Click="AcceptUpdateChecks" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="update-consent-on" /></StackPanel>
      <StackPanel x:Name="UpdateNoticeButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button x:Name="UpdateLater" Content="Later" Click="LaterUpdate" Margin="0,0,10,0" AutomationProperties.AutomationId="update-later" /><Button x:Name="UpdateSkip" Content="Skip this version" Click="SkipUpdate" Margin="0,0,10,0" AutomationProperties.AutomationId="update-skip" /><Button x:Name="UpdateView" Content="View release" Click="ViewRelease" Margin="0,0,10,0" AutomationProperties.AutomationId="update-view" /><Button x:Name="UpdateDownload" Content="Download update" Click="DownloadUpdate" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="update-download" /><Button x:Name="UpdateCancel" Content="Cancel download" Click="CancelUpdateDownload" AutomationProperties.AutomationId="update-cancel" /><Button x:Name="UpdateRestart" Content="Restart to update" Click="RestartToUpdate" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="update-restart" /></StackPanel>
    </StackPanel></Border>
    <ScrollViewer Grid.Row="2" x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel}"><StackPanel>
            <TextBlock Text="Pair your phone" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Scan with your phone's camera, open the link in its browser, then approve on this PC." Style="{StaticResource MutedText}" />
            <Border Width="230" Height="230" Background="White" CornerRadius="14" Padding="12" Margin="0,22,0,16"><Grid><TextBlock x:Name="QrPlaceholder" Text="Create a pairing link&#10;to show your QR code" Foreground="#536171" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" /><Image x:Name="PairQr" Stretch="Uniform" /></Grid></Border>
            <TextBlock x:Name="PairStatus" Style="{StaticResource MutedText}" TextAlignment="Center" MinHeight="21" Margin="0,0,0,14" />
            <Button Content="Create new pairing link" Click="NewPairing" Style="{StaticResource PrimaryButton}" MinHeight="50" />
            <TextBlock Text="Connection address" Style="{StaticResource MutedText}" Margin="0,22,0,8" />
            <TextBox x:Name="Address" IsReadOnly="True" FontSize="16" />
          </StackPanel></Border>
          <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition /></Grid.RowDefinitions>
            <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Control" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="OwnerStatus" Text="No active controller" Style="{StaticResource MutedText}" Margin="0,0,0,22" /><Button x:Name="PauseButton" Content="Pause control" Click="TogglePause" MinHeight="50" /></StackPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Paired devices" Style="{StaticResource SectionTitle}" /><StackPanel x:Name="DeviceList" Margin="0,8,0,0" /></StackPanel></Border>
          </Grid>
        </Grid>
        <Expander x:Name="CertificateSettings" Header="Certificate &amp; network setup" Margin="0,16,0,0"><StackPanel>
          <TextBlock x:Name="NetworkNotice" Style="{StaticResource MutedText}" />
          <TextBlock x:Name="OtherAddresses" Style="{StaticResource MutedText}" Margin="0,8,0,16" />
          <Button Content="Configure Private LAN firewall (administrator prompt)…" Click="ConfigurePrivateFirewall" HorizontalAlignment="Left" Margin="0,0,0,20" />
          <TextBlock Text="1. Export the public trust profile to your phone (iPhone/iPad profile; other devices import pc-remote-root.cer)." Style="{StaticResource MutedText}" />
          <Button x:Name="Export" Content="Save trust profile…" Click="ExportProfile" IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,16" />
          <TextBlock Text="2. Install the profile, then enable full trust in Settings → General → About → Certificate Trust Settings. Confirm this fingerprint against the profile before trusting it." Style="{StaticResource MutedText}" />
          <TextBox x:Name="Fingerprint" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,16" />
          <TextBlock Text="3. Scan the pairing QR or paste the complete link into the phone's browser. Enter a device name, request pairing, then approve the request on this PC. Each browser, including the Home Screen app, may need its own approval." Style="{StaticResource MutedText}" />
          <TextBox x:Name="PairLink" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel></Expander>
        <Expander x:Name="Preferences" Header="Apps, audio, power &amp; preferences" Visibility="Collapsed" Margin="0,12,0,0"><StackPanel>
          <TextBlock Text="App launcher" Style="{StaticResource SectionTitle}" /><TextBlock Text="Only these apps can be opened from your phone. Choose each app’s media profile when adding it." Style="{StaticResource MutedText}" />
          <StackPanel x:Name="LauncherList" Margin="0,16,0,0" /><Button Content="Add an app…" Click="AddLauncherApp" HorizontalAlignment="Left" Margin="0,8,0,20" />
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Windows output volume" Style="{StaticResource MutedText}" /><TextBlock x:Name="DesktopVolumeValue" Grid.Column="1" Text="—" Foreground="{StaticResource AccentBrush}" /></Grid>
          <Slider x:Name="DesktopVolume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="False" MinHeight="44" ValueChanged="DesktopVolumeChanged" PreviewMouseLeftButtonUp="CommitDesktopVolume" PreviewKeyUp="CommitDesktopVolume" LostKeyboardFocus="CommitDesktopVolume" AutomationProperties.Name="Windows output volume" />
          <TextBlock x:Name="DesktopAudioStatus" Style="{StaticResource MutedText}" Margin="0,0,0,20" />
          <TextBlock Text="Power controls" Style="{StaticResource SectionTitle}" /><StackPanel Orientation="Horizontal"><Button Content="Sleep" Tag="sleep" Click="RequestLocalPower" Margin="0,0,10,0" /><Button Content="Restart" Tag="restart" Click="RequestLocalPower" Margin="0,0,10,0" /><Button Content="Shut down" Tag="shutdown" Click="RequestLocalPower" /></StackPanel>
          <TextBlock x:Name="DesktopPowerStatus" Style="{StaticResource MutedText}" Margin="0,12,0,8" /><Button x:Name="CancelDesktopPower" Content="Cancel power action" Click="CancelLocalPower" IsEnabled="False" HorizontalAlignment="Left" Margin="0,0,0,24" />
          <TextBlock Text="Pointer sensitivity (0.25–4)" Style="{StaticResource MutedText}" Margin="0,0,0,8" /><TextBox x:Name="Sensitivity" Width="160" HorizontalAlignment="Left" />
          <CheckBox x:Name="NaturalScroll" Content="Natural scrolling (content follows fingers)" Margin="0,12,0,8" /><Button Content="Save pointer settings" Click="SavePointerSettings" HorizontalAlignment="Left" />
          <TextBlock Text="Media profile (focus the matching player on the PC)" Style="{StaticResource MutedText}" Margin="0,24,0,8" /><ComboBox x:Name="MediaProfile" Width="240" HorizontalAlignment="Left" /><Button Content="Save media profile" Click="SaveMediaProfile" HorizontalAlignment="Left" Margin="0,8,0,0" />
          <CheckBox x:Name="StartupAtSignIn" Content="Start PC Remote at sign-in (this Windows account)" Margin="0,24,0,8" /><Button Content="Save sign-in preference" Click="SaveStartup" HorizontalAlignment="Left" />
          <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" Margin="0,28,0,8" />
          <TextBlock x:Name="UpdateExplanation" Text="Checks only ask GitHub whether a newer signed release exists; they never download or install anything. GitHub sees this PC's IP address; no device, pairing or setting information is sent." Style="{StaticResource MutedText}" />
          <CheckBox x:Name="UpdateAutomatic" Content="Check GitHub for new versions automatically (once a day)" Click="ToggleUpdateChecks" Margin="0,12,0,8" AutomationProperties.AutomationId="update-automatic" />
          <Button x:Name="UpdateCheckNow" Content="Check now" Click="CheckUpdatesNow" HorizontalAlignment="Left" AutomationProperties.AutomationId="update-check-now" />
          <TextBlock x:Name="UpdateStatus" Style="{StaticResource MutedText}" Margin="0,8,0,0" AutomationProperties.AutomationId="update-status" />
          <TextBlock Text="Right-click the tray icon for Open, Pause control, Resume control or Exit." Style="{StaticResource MutedText}" Margin="0,20,0,8" /><Button Content="Exit PC Remote" Click="ExitApp" HorizontalAlignment="Left" />
        </StackPanel></Expander>
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="3" Text="Closing this window keeps PC Remote in the notification tray." Foreground="#A1ADBD" FontSize="13" LineHeight="20" TextAlignment="Center" Margin="0,16,0,0" />
  </Grid>
</Window>
