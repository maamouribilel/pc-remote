<Project>
  <PropertyGroup>
    <PcRemoteVersion>0.3.5</PcRemoteVersion>
    <Version>$(PcRemoteVersion)</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <Target Name="ValidateProductVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Version)' != '$(PcRemoteVersion)'" Text="Product version must match Directory.Build.props PcRemoteVersion." />
  </Target>
</Project>
